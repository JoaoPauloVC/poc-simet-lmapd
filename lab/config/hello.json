{
    "ietf-lmap-control:lmap": {
        "tasks": {
            "task": [
                {
                    "name": "hello-world",
                    "program": "/home/joao-medicoes-laptop/Documentos/nic.br/orquestracao-medicoes-lmap-controller/poc-simet-lmapd/simet-lmapd/lab/bin/hello-world.sh"
                }
            ]
        },
        "events": {
            "event": [
                {
                    "name": "every-5-seconds",
                    "periodic": {
                        "interval": 5,
                        "start": "2026-09-03T10:30:00-03:00"
                    }
                },
                {
                    "name": "every-7-seconds",
                    "periodic": {
                        "interval": 7,
                        "start": "2026-09-03T10:30:00-03:00"
                    }
                }
            ]
        },
        "schedules": {
            "schedule": [
                {
                    "name": "hello-schedule-5s",
                    "start": "every-5-seconds",
                    "execution-mode": "sequential",
                    "action": [
                        {
                            "name": "run-hello-5s",
                            "task": "hello-world"
                        }
                    ]
                },
                {
                    "name": "hello-schedule-7s",
                    "start": "every-7-seconds",
                    "execution-mode": "sequential",
                    "action": [
                        {
                            "name": "run-hello-7s",
                            "task": "hello-world"
                        }
                    ]
                }
            ]
        }
    }
}